# ==============================================================================
# CẤU HÌNH SUPABASE & DATABASE
# ==============================================================================
# Chuỗi kết nối Supabase PostgreSQL (Lấy tại Project Settings -> Database -> Connection String)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API (Lấy tại Project Settings -> API)
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ==============================================================================
# CẤU HÌNH QUẢN TRỊ VIÊN & BẢO MẬT
# ==============================================================================
# Email duy nhất của Manager được phép truy cập trang quản trị admin
MANAGER_EMAIL="manager@restaurant.com"

# Đường dẫn URL ứng dụng (dùng tạo link xác thực / mở khóa trong email)
APP_URL="http://localhost:3000"

# Secret key cho cookie session
SESSION_SECRET="super-secret-restaurant-key"

# ==============================================================================
# CẤU HÌNH GỬI EMAIL THÔNG BÁO MỞ KHÓA (SMTP / GMAIL)
# ==============================================================================
# Khi người dùng nhập sai 5 lần, hệ thống sẽ gửi email chứa link mở khóa qua SMTP này
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ==============================================================================
# CẤU HÌNH CAPTCHA (Cloudflare Turnstile)
# ==============================================================================
# Lấy tại Cloudflare Dashboard -> Turnstile
TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Cổng khởi chạy server (mặc định 3000)
PORT=3000
