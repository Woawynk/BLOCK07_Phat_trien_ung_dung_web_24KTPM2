
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Dishes
model Dish {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       Int          @default(0)
  category    String?
  imageUrl    String?      @map("image_url")
  available   Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  chefId      Int?         @map("chef_id")
  chef        Chef?        @relation(fields: [chefId], references: [id], onDelete: SetNull)
  ingredients Ingredient[]

  @@map("dishes")
}

// 2. Chefs
model Chef {
  id        Int      @id @default(autoincrement())
  name      String
  specialty String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dishes    Dish[]

  @@map("chefs")
}

// 3. Ingredients
model Ingredient {
  id        Int      @id @default(autoincrement())
  name      String
  unit      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  dishes    Dish[]

  @@map("ingredients")
}

// 4. User Profiles
model Profile {
  id                  String    @id @db.Uuid
  username            String    @unique
  email               String    @unique
  dob                 DateTime? @db.Date

  role                String    @default("user")
  allowedCategories   String[]  @default([]) @map("allowed_categories")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  isLocked            Boolean   @default(false) @map("is_locked")

  unlockToken         String?   @unique @map("unlock_token")
  unlockTokenExpires  DateTime? @map("unlock_token_expires") @db.Timestamptz(6)

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}
