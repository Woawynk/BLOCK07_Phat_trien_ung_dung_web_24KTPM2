<%- include('../../partials/header') %>

<div style="margin-bottom: 1.5rem;">
  <a href="/admin/ingredients" class="btn btn-secondary">&larr; Quay lại danh sách nguyên liệu</a>
</div>

<div class="form-card">
  <h1 style="font-size: 1.6rem; margin-bottom: 1.25rem;">Thêm Nguyên Liệu Mới</h1>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert-error">
      <strong>Vui lòng kiểm tra lại thông tin:</strong>
      <ul>
        <% errors.forEach(err => { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/admin/ingredients">
    <div class="form-group">
      <label class="form-label" for="name">Tên nguyên liệu <span style="color: var(--danger);">*</span></label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-control"
        placeholder="Ví dụ: Thịt thăn bò, Hành lá, Nước mắm..."
        value="<%= formData ? formData.name : '' %>"
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="unit">Đơn vị tính <span style="color: var(--danger);">*</span></label>
      <input
        type="text"
        id="unit"
        name="unit"
        class="form-control"
        placeholder="Ví dụ: kg, gram, bó, quả, chai (500ml)..."
        value="<%= formData ? formData.unit : '' %>"
        required
      >
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary">Lưu Nguyên Liệu</button>
      <a href="/admin/ingredients" class="btn btn-secondary">Hủy bỏ</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
