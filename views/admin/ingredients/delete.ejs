<%- include('../../partials/header') %>

<div style="margin-bottom: 1.5rem;">
  <a href="/admin/ingredients" class="btn btn-secondary">&larr; Quay lại danh sách nguyên liệu</a>
</div>

<div class="form-card" style="border-color: #fecaca; background: #fffaf0;">
  <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
    <span style="font-size: 2rem;">⚠️</span>
    <h1 style="font-size: 1.6rem; color: var(--danger);">Xác Nhận Xóa Nguyên Liệu</h1>
  </div>

  <p style="font-size: 1.05rem; margin-bottom: 1.25rem;">
    Bạn có chắc chắn muốn xóa nguyên liệu thực phẩm sau đây khỏi hệ thống không?
  </p>

  <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
    <p><strong>Mã nguyên liệu (ID):</strong> #<%= ingredient.id %></p>
    <p><strong>Tên nguyên liệu:</strong> <%= ingredient.name %></p>
    <p><strong>Đơn vị tính:</strong> <%= ingredient.unit %></p>
  </div>

  <form method="POST" action="/admin/ingredients/<%= ingredient.id %>?_method=DELETE">
    <div style="display: flex; gap: 1rem;">
      <button type="submit" class="btn btn-danger">Xác Nhận Xóa Vĩnh Viễn</button>
      <a href="/admin/ingredients" class="btn btn-secondary">Không, quay lại</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
