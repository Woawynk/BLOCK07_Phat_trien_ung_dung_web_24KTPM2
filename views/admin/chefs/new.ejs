<%- include('../../partials/header') %>

<div style="margin-bottom: 1.5rem;">
  <a href="/admin/chefs" class="btn btn-secondary">&larr; Quay lại danh sách đầu bếp</a>
</div>

<div class="form-card">
  <h1 style="font-size: 1.6rem; margin-bottom: 1.25rem;">Thêm Đầu Bếp Mới</h1>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div class="alert-error">
      <strong>Vui lòng kiểm tra lại thông tin:</strong>
      <ul>
        <% errors.forEach(err => { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="/admin/chefs">
    <div class="form-group">
      <label class="form-label" for="name">Họ và tên đầu bếp <span style="color: var(--danger);">*</span></label>
      <input
        type="text"
        id="name"
        name="name"
        class="form-control"
        placeholder="Ví dụ: Nguyễn Văn Hùng"
        value="<%= formData ? formData.name : '' %>"
        required
      >
    </div>

    <div class="form-group">
      <label class="form-label" for="specialty">Sở trường / Chuyên môn <span style="color: var(--danger);">*</span></label>
      <input
        type="text"
        id="specialty"
        name="specialty"
        class="form-control"
        placeholder="Ví dụ: Bếp trưởng - Chuyên gia món phở & nước dùng truyền thống"
        value="<%= formData ? formData.specialty : '' %>"
        required
      >
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary">Lưu Đầu Bếp</button>
      <a href="/admin/chefs" class="btn btn-secondary">Hủy bỏ</a>
    </div>
  </form>
</div>

<%- include('../../partials/footer') %>
