<%- include('../../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Quản Trị Nhà Hàng</h1>
    <p style="color: var(--text-muted); margin-top: 0.25rem;">Hệ thống CRUD quản lý Món ăn, Đầu bếp và Nguyên liệu (SSR + Prisma)</p>
  </div>
</div>

<!-- Admin Tabs chuyển đổi 3 đối tượng -->
<div class="admin-tabs">
  <a href="/admin/dishes" class="active">🍲 Danh Sách Món Ăn</a>
  <a href="/admin/chefs">👨‍🍳 Quản Lý Đầu Bếp</a>
  <a href="/admin/ingredients">🥬 Quản Lý Nguyên Liệu</a>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
  <h2 style="font-size: 1.3rem;">Tất cả món ăn (<%= dishes.length %>)</h2>
  <!-- Mở form thêm GET /admin/dishes/new -->
  <a href="/admin/dishes/new" class="btn btn-primary">+ Thêm Món Ăn Mới</a>
</div>

<div class="table-responsive">
  <table class="table">
    <thead>
      <tr>
        <th style="width: 60px;">ID</th>
        <th>Tên món ăn</th>
        <th>Danh mục</th>
        <th>Đơn giá</th>
        <th>Trạng thái</th>
        <th style="text-align: right;">Hành động</th>
      </tr>
    </thead>
    <tbody>
      <% if (dishes.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 2rem;">Chưa có món ăn nào trong hệ thống.</td>
        </tr>
      <% } else { %>
        <% dishes.forEach(d => { %>
          <tr>
            <td><strong>#<%= d.id %></strong></td>
            <td>
              <a href="/dishes/<%= d.id %>" style="font-weight: 600; text-decoration: none; color: var(--primary-color);">
                <%= d.name %>
              </a>
            </td>
            <td><%= d.category || '—' %></td>
            <td style="font-weight: 700;"><%= Number(d.price).toLocaleString('vi-VN') %> đ</td>
            <td>
              <% if (d.available) { %>
                <span class="badge badge-success">Đang phục vụ</span>
              <% } else { %>
                <span class="badge badge-danger">Hết món</span>
              <% } %>
            </td>
            <td>
              <div class="actions" style="justify-content: flex-end;">
                <!-- Link mở trang chi tiết -->
                <a href="/dishes/<%= d.id %>" class="btn btn-sm btn-secondary" title="Xem chi tiết">Xem</a>
                <!-- Link mở form sửa GET /admin/dishes/:id/edit -->
                <a href="/admin/dishes/<%= d.id %>/edit" class="btn btn-sm btn-secondary" title="Sửa món">Sửa</a>
                <!-- Link mở trang xác nhận xóa GET /admin/dishes/:id/delete -->
                <a href="/admin/dishes/<%= d.id %>/delete" class="btn btn-sm btn-danger" title="Xóa món">Xóa</a>
              </div>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../../partials/footer') %>
